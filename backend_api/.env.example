# Backend API environment variables (example)
# Copy into your environment manager / deployment config. Do not commit real secrets.

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database (required)
POSTGRES_URL=postgresql://...
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=code_review_assistant
POSTGRES_PORT=5432

# Auth
JWT_SECRET=change-me

# CORS
# Comma-separated list of allowed origins (set to the frontend URL in production).
# If omitted, the backend currently allows all origins ("*") by default.
ALLOWED_ORIGINS=https://your-frontend-host:3000
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=3600
